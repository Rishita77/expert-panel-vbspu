# Local foundation configuration. Railway has its own secret service variables.
# Native development uses these settings directly via environment variables.
# Docker Compose reads this file when copied to .env.
POSTGRES_DB=vbspu
POSTGRES_USER=vbspu
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
APP_MODE=preview

# Email OTP and CAPTCHA are disabled in the local safe configuration. Railway
# production will set these values through its secret environment variables.
EMAIL_OTP_ENABLED=0
EMAIL_OTP_PROVIDER=console
DEFAULT_FROM_EMAIL=emailadmin.vbspu@gmail.com
GMAIL_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_OAUTH_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
TURNSTILE_ENABLED=0
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret

# Railway only — do not place production values in a local .env file.
# APP_MODE=production
# APP_PUBLIC_URL=https://your-railway-domain.up.railway.app
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# PRIVATE_DOCUMENT_ROOT=/app/private-documents
